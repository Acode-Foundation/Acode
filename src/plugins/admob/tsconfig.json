{
  "compilerOptions": {
    "composite": true,
    "outDir": "lib",
    "rootDir": "src/www",
    "target": "ES2015",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["DOM", "ES2015"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./src/www/cordova.d.ts", "./src/www/**/*"]
}
