{
  "name": "admob-plus-cordova",
  "version": "2.0.0-alpha.19",
  "description": "Trustable Google AdMob Cordova Plugin, successor of cordova-plugin-admob-free. Unlike some Cordova AdMob plugins, no ad-sharing, free to use. TypeScript friendly. Compatible with Ionic. admob-plus-cordova is one of the most popular Cordova AdMob plugins.",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node ./scripts/build.mjs",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "25.0.8",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/cordova": "^11.0.3",
    "rollup": "3.30.0",
    "tslib": "^2.8.1",
    "typescript": "5.1.6"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "author": "Ratson",
  "license": "MIT",
  "repository": "admob-plus/admob-plus",
  "homepage": "https://admob-plus.github.io/docs/cordova",
  "funding": "https://admob-plus.github.io/funding",
  "files": [
    "*.ts",
    "*.md",
    "*.xml",
    "esm",
    "lib",
    "scripts",
    "src",
    "ts",
    "www",
    "!**/*.tsbuildinfo"
  ],
  "keywords": [
    "cordova",
    "admob",
    "admob-cordova",
    "cordova-admob",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "cordova-plugin",
    "ad",
    "admob-plus",
    "admob-plus-cordova",
    "cordova-plugin-admob-free",
    "google-admob",
    "monetization",
    "typescript"
  ],
  "source": {
    "coverage": {
      "include": [
        "src/www/**/*.ts"
      ]
    }
  },
  "cordova": {
    "id": "admob-plus-cordova",
    "platforms": [
      "android",
      "browser",
      "ios"
    ]
  }
}
