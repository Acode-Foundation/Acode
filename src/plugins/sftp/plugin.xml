<?xml version="1.0" encoding="UTF-8"?>

<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-plugin-sftp"
    version="2.0.0">

    <name>Sftp</name>
    <description>Cordova SFTP and SSH plugin</description>
    <license>Apache-2.0</license>
    <keywords>cordova,sftp,ssh,ftp</keywords>

    <js-module src="www/sftp.js" name="sftp">
        <clobbers target="window.sftp" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="Sftp">
                <param name="android-package" value="com.foxdebug.sftp.SftpPlugin" />
            </feature>
        </config-file>

        <source-file src="src/com/foxdebug/sftp/SftpPlugin.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/SftpSession.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/SftpOperationQueue.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/HostKeyVerifier.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/SftpSecurityStore.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/RemoteShell.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/WebConfirm.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/Transfer.java" target-dir="src/com/foxdebug/sftp" />
        <source-file src="src/com/foxdebug/sftp/Metadata.java" target-dir="src/com/foxdebug/sftp" />
    </platform>

    <framework src="com.sshtools:maverick-synergy-client:3.1.4" />
    <framework src="org.bouncycastle:bcprov-jdk15to18:1.83" />
    <framework src="org.bouncycastle:bcpkix-jdk15to18:1.83" />
</plugin>
